# Settings for the DJ room server on this box. deploy/remote.sh copies this to
# /srv/faceland-dj/dj.env the first time and never overwrites it afterwards.
# After editing: cd /srv/faceland-dj/app/deploy && docker compose up -d
#
# Every variable the server reads is listed in dj-server/README.md.

# Pages allowed to open the room. The dev page is http://localhost:3000; add
# a staging site here when there is one. '*' disables the check.
ALLOWED_ORIGINS=https://face.land,http://localhost:3000

# Optional YouTube Data API v3 key. With it, song lengths are exact and live
# streams are refused; without it, titles come from oEmbed and lengths from
# listeners' players. One quota unit per new video, 10,000 a day free.
#YOUTUBE_API_KEY=

# Product tuning (defaults shown).
#MIN_SKIP_SECONDS=10
#MAX_TRACK_MINUTES=15
#AFK_SECONDS=60
