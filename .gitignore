# NOTE: this is the SOURCE branch. Build output goes to /build and is published
# to the `master` deploy branch, where the built site IS tracked at the repo
# root. Keep this file in sync with master's .gitignore.

# --- Claude Code ---
.claude/
CLAUDE.local.md

# --- JetBrains (WebStorm, IntelliJ, ...) ---
.idea/
.idea_modules/
*.iml
*.iws
*.ipr

# --- VS Code / Zed / Sublime ---
.vscode/
.zed/
*.sublime-project
*.sublime-workspace

# --- Vim / Emacs ---
*.swp
*.swo
*~
\#*#
.#*

# --- Dependencies ---
/node_modules
/.pnp
.pnp.js
/.yarn

# --- Build output ---
/build
/coverage

# --- Logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Local env ---
# `.env` itself is tracked on purpose: it holds public build config (Auth0
# domain + SPA client ID, both shipped in the browser bundle) and no secrets.
# Only local overrides are ignored.
.env.local
.env.*.local

# --- Lockfiles ---
/package-lock.json
/yarn.lock

# --- OS cruft ---
.DS_Store
Thumbs.db
